<view class="container admin-page">

  <!-- 顶部栏 -->
  <view class="top-bar">
    <button class="btn-ghost" bindtap="handleBack">← 返回</button>
    <button class="btn-danger-sm" bindtap="handleLogout">退出</button>
  </view>

  <text class="page-title">管理员控制台</text>

  <!-- ── 战队列表 ── -->
  <view class="section-header">
    <text class="section-title">战队列表</text>
    <button class="btn-primary-sm" bindtap="toggleNewSquadForm">{{showNewSquadForm ? '收起' : '+ 新建战队'}}</button>
  </view>

  <view wx:if="{{fetchError}}" class="error-banner">{{fetchError}}</view>
  <view wx:elif="{{loadingSquads}}" class="hint">加载中...</view>
  <view wx:elif="{{squads.length === 0}}" class="hint">暂无战队</view>

  <view class="squad-card" wx:for="{{squads}}" wx:key="id">
    <view class="squad-name">{{item.squad_name}}</view>
    <view class="info-row">
      <text class="info-label">邀请码</text>
      <text class="invite-code">{{item.invite_code}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">成员人数</text>
      <text class="info-value">{{item.member_count}} / {{item.max_members}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">状态</text>
      <text class="info-value {{item.is_active ? 'text-green' : 'text-grey'}}">{{item.is_active ? '开放' : '已关闭'}}</text>
    </view>

    <!-- 操作按钮 -->
    <view class="card-actions">
      <button class="btn-outline" data-id="{{item.id}}" bindtap="toggleMembers">
        {{expandedSquadId === item.id ? '收起成员' : '查看成员'}}
      </button>
      <button class="btn-danger-outline" data-id="{{item.id}}" data-name="{{item.squad_name}}" bindtap="deleteSquad">删除战队</button>
    </view>

    <!-- 成员列表 -->
    <view class="members-section" wx:if="{{expandedSquadId === item.id}}">
      <view wx:if="{{!squadMembers[item.id] || squadMembers[item.id].length === 0}}" class="members-empty">暂无成员</view>
      <view class="member-row" wx:for="{{squadMembers[item.id]}}" wx:key="id" wx:for-item="member">
        <view class="member-info">
          <view class="member-main">
            <text class="member-nickname">{{member.nickname || '未设置昵称'}}</text>
            <text class="member-lc">{{member.leetcode_username || '未绑定LC'}}</text>
          </view>
          <text class="member-openid">{{member.openid}}</text>
        </view>
        <button class="btn-remove" data-squad-id="{{item.id}}" data-user-id="{{member.id}}" data-name="{{member.nickname}}" bindtap="removeMember">移除</button>
      </view>
    </view>
  </view>

  <!-- ── 新建战队表单 ── -->
  <view class="form-section" wx:if="{{showNewSquadForm}}">
    <text class="section-title">新建战队</text>
    <view class="field">
      <text class="field-label">战队名称</text>
      <input class="field-input" placeholder="例如：CESA战队" value="{{newSquadName}}" bindinput="onSquadNameInput" />
    </view>
    <view class="field">
      <text class="field-label">邀请码</text>
      <input class="field-input" placeholder="唯一，区分大小写" value="{{newInviteCode}}" bindinput="onInviteCodeInput" />
    </view>
    <view class="field">
      <text class="field-label">人数上限</text>
      <input class="field-input" type="number" placeholder="默认 50" value="{{newMaxMembers}}" bindinput="onMaxMembersInput" />
    </view>
    <text class="form-error" wx:if="{{squadFormError}}">{{squadFormError}}</text>
    <button class="btn-primary mt-16" loading="{{submittingSquad}}" disabled="{{submittingSquad}}" bindtap="handleCreateSquad">
      {{submittingSquad ? '创建中...' : '确认创建'}}
    </button>
  </view>



</view>
