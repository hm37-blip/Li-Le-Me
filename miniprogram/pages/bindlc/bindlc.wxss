.bind-page {
  padding-top: 40rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #222222;
}

.subtitle {
  font-size: 26rpx;
  color: #666666;
}

.input {
  height: 88rpx;
  border: 2rpx solid #d9d9d9;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  background: #ffffff;
  transition: border-color 0.2s;
}

.input:focus {
  border-color: #07c160;
}

.input-error {
  border-color: #e53935 !important;
  box-shadow: 0 0 0 2rpx rgba(229, 57, 53, 0.12);
}

.error-text {
  display: block;
  margin-top: 12rpx;
  color: #d93025;
  font-size: 24rpx;
  font-weight: 500;
}

.rules-box {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.rule {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.rule-icon {
  font-size: 26rpx;
  color: #bbbbbb;
  width: 28rpx;
  text-align: center;
}

.rule-text {
  font-size: 24rpx;
  color: #999999;
}

.rule.pass .rule-icon,
.rule.pass .rule-text {
  color: #07c160;
}

.submit-btn {
  background-color: #07c160 !important;
  border: none;
  border-radius: 12rpx;
}
