/* pages/report/report.wxss */

/* LeetCode 配色变量 - 纯橙灰配色 */
page {
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
  position: relative;
  z-index: 0;
  /* 主色调 */
  --leetcode-orange: #FFA116;
  --leetcode-dark: #282828;

  /* 难度颜色 - 灰色渐变 */
  --leetcode-easy: #FFA116;      /* 浅灰 */
  --leetcode-medium: #FFA116;    /* 橙色 */
  --leetcode-hard: #FFA116;      /* 深灰 */

  /* 背景色 - 灰色系 */
  --weui-BG-0: #282828;          /* 页面背景 */
  --weui-BG-1: #282828;          /* 卡片背景 */
  --weui-BG-2: #282828;          /* 次级背景 */

  /* 字体大小规范 */
  --font-size-title: 16px;
  --font-size-body: 14px;
  --font-size-caption: 12px;
}

.page {
  background-color: var(--weui-BG-0);
  min-height: 100vh;
  padding-bottom: 40rpx;
  position: relative;
  z-index: 0;
}

.page__bd {
  padding: 0;
  position: relative;
  z-index: 0;
}

/* ==================== WeUI Panel 样式 ==================== */
.weui-panel {
  background-color: var(--weui-BG-1);
  margin-top: 30rpx;
  overflow: hidden;
  position: relative;
  z-index: 0;
}

.weui-panel:first-child {
  margin-top: 0rpx;
}

.weui-panel__hd {
  padding: 28rpx 30rpx 20rpx;
  color: #ffffff;
  font-size: var(--font-size-title);
  font-weight: 600;
  position: relative;
}

.weui-panel__hd:before {
  content: '';
  position: absolute;
  left: 15rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 32rpx;
  background-color: var(--leetcode-orange);
  border-radius: 3rpx;
}

.weui-panel__bd {
  padding: 0 30rpx 30rpx;
}

.weui-panel_access {
  margin-top: 30rpx;
  margin-bottom: 0;
}

/* ==================== 用户信息卡片 ==================== */
.user-info-box {
  display: flex;
  align-items: center;
  padding: 50rpx 30rpx 0rpx;
  background: #282828;
}

.weui-media-box__hd {
  margin-right: 28rpx;
  width: 120rpx;
  height: 120rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  border: 6rpx solid var(--leetcode-orange);
  box-shadow: 0 4rpx 12rpx rgba(255, 161, 22, 0.2);
}

.weui-media-box__bd {
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: var(--font-size-body);
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.openid-text {
  font-size: var(--font-size-caption);
  color: #999;
  word-break: break-all;
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.points-container {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-top: 4rpx;
}

.points-item {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 12rpx;
}

.points-label {
  font-size: var(--font-size-caption);
  color: #999;
}

.points-value {
  font-size: var(--font-size-caption);
  font-weight: 700;
  color: var(--leetcode-orange);
  line-height: 1;
}

.streak-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(135deg, var(--leetcode-orange) 0%, #ff8c00 100%);
  padding: 24rpx 32rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 161, 22, 0.3);
  min-width: 120rpx;
}

.streak-number {
  font-size: 44px;
  font-weight: 700;
  color: white;
  line-height: 1;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.streak-label {
  font-size: var(--font-size-body);
  color: white;
  opacity: 0.95;
  margin-top: 4rpx;
}

.streak-desc {
  font-size: var(--font-size-caption);
  color: white;
  opacity: 0.85;
  margin-top: 4rpx;
}

/* ==================== WeUI Navbar (Tab切换) ==================== */
.weui-tab {
  position: relative;
}

.weui-navbar {
  display: flex;
  position: relative;
  background-color: #e8e8e8;
  border-radius: 12rpx;
  overflow: hidden;
}

.weui-navbar__item {
  position: relative;
  flex: 1;
  padding: 24rpx 0;
  text-align: center;
  font-size: var(--font-size-body);
  color: #666;
  transition: all 0.3s;
}

.weui-navbar__item.weui-bar__item_on {
  color: white;
  background-color: var(--leetcode-orange);
  font-weight: 600;
}

.weui-navbar__item.weui-bar__item_on .weui-navbar__title {
  color: white;
}

.weui-navbar__title {
  display: inline-block;
  color: inherit;
}

/* ==================== 图表容器 ==================== */
.chart-desc {
  font-size: var(--font-size-caption);
  color: #999;
  margin-bottom: 24rpx;
  padding: 0 4rpx;
}

.chart-container {
  width: 100%;
  height: 360rpx;
  background-color: #f8f8f8;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
  display: block;
  z-index: 0;
}

/* ==================== WeUI Grids (统计数据) ==================== */
.weui-grids {
  display: flex;
  flex-wrap: wrap;
  background-color: transparent;
  border-radius: 12rpx;
  overflow: hidden;
}

.weui-grid {
  position: relative;
  padding: 40rpx 20rpx;
  width: 33.33333333%;
  box-sizing: border-box;
  text-align: center;
}

.stat-grid-item {
  background-color: #fafafa;
  margin: 8rpx;
  border-radius: 12rpx;
  width: calc(33.33% - 16rpx);
  border: 2rpx solid #e8e8e8;
}

.stat-value {
  font-size: 40px;
  font-weight: 700;
  line-height: 1.2;
  margin-bottom: 12rpx;
}

.stat-easy {
  color: var(--leetcode-easy);
}

.stat-medium {
  color: var(--leetcode-medium);
}

.stat-hard {
  color: var(--leetcode-hard);
}

.weui-grid__label {
  display: block;
  font-size: var(--font-size-body);
  color: #999;
  margin-top: 8rpx;
}

/* ==================== 响应式适配 ==================== */
@media (max-width: 320px) {
  .user-avatar {
    width: 100rpx;
    height: 100rpx;
  }

  .streak-badge {
    padding: 20rpx 24rpx;
    min-width: 100rpx;
  }

  .streak-number {
    font-size: 36px;
  }
}
