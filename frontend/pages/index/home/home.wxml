<!--pages/home/home.wxml-->
<scroll-view class="page" scroll-y="{{true}}" enable-back-to-top="{{true}}">
  <view class="header">
    <text class="header-title">首页</text>
    <text class="header-subtitle">今日刷题排行榜</text>
  </view>

  <!-- 我的简要信息卡片 -->
  <view class="summary-card">
    <view class="card-content">
      <image class="my-avatar" src="{{myInfo.avatarUrl}}" mode="aspectFill"></image>
      <view class="my-info">
        <view class="info-row">
          <text class="my-name">{{myInfo.lcId || 'Guest'}}</text>
          <text class="my-tier">{{myInfo.rankTier}}</text>
        </view>
        <view class="info-row-stats">
          <text class="stat-item">排名 {{myInfo.rank || '-'}}</text>
          <text class="stat-divider">|</text>
          <text class="stat-item">总积分 {{myInfo.totalSolved || 0}}</text>
          <text class="stat-divider">|</text>
          <text class="stat-item">今日 +{{myInfo.dailySteps}}</text>
        </view>
      </view>
      <view class="share-btn" bindtap="shareAchievement">
        <text class="share-text">分享</text>
      </view>
    </view>
  </view>

  <!-- 战队信息 -->
  <view class="team-header">
    <text class="team-name">{{teamName}}</text>
    <text class="team-count">{{teamMemberCount}}/{{teamMemberLimit}}</text>
  </view>

  <!-- 榜单标题 -->
  <view class="section-header">
    <text class="section-title">战队排行榜</text>
    <text class="section-desc">按今日积分排序</text>
  </view>

  <!-- 排行榜 -->
  <view class="leaderboard">
    <block wx:for="{{rankList}}" wx:key="openid">
      <view class="rank-item">
        <view class="rank-left">
          <view class="rank-badge {{item.rank <= 3 ? 'top-rank' : ''}}">
            {{item.rank}}
          </view>

          <image class="avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>

          <view class="user-info">
            <text class="nickname">{{item.nickname}}</text>
            <text class="lcid">LC: {{item.lcId}}</text>
          </view>
        </view>

        <view class="rank-right">
          <text class="total-count">{{item.totalSolved}}</text>
          <text class="daily-add">+{{item.dailySteps}} today</text>
        </view>
      </view>
    </block>
  </view>

  <!-- 加载状态 -->
  <view class="loading-area" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-area" wx:if="{{!loading && rankList.length === 0}}">
    <text class="empty-text">暂无排行数据</text>
  </view>
</scroll-view>

<custom-tabbar current="{{0}}"></custom-tabbar>
