page {
  background: #282828;
  height: 100vh;
}

.page {
  height: 100vh;
  box-sizing: border-box;
  padding: 40rpx 32rpx calc(180rpx + env(safe-area-inset-bottom)) 32rpx;
  background: #282828;
}

/* 顶部 */
.header {
  margin-bottom: 36rpx;
}

.header-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.header-subtitle {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.65);
}

/* 我的简要信息卡片 */
.summary-card {
  background: linear-gradient(135deg, #ffa116 0%, #ffb84d 100%);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(255, 161, 22, 0.15);
}

.card-content {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.my-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f3f3f3;
  border: 3rpx solid rgba(255, 255, 255, 0.4);
  flex-shrink: 0;
}

.my-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.info-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.my-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.my-tier {
  font-size: 22rpx;
  font-weight: 600;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.25);
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.info-row-stats {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}

.stat-item {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
}

.stat-divider {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.5);
}

.share-btn {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 32rpx;
  padding: 14rpx 24rpx;
  flex-shrink: 0;
  transition: all 0.3s ease;
}

.share-btn:active {
  transform: scale(0.95);
  opacity: 0.8;
}

.share-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #ffa116;
}

/* 分区标题 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
}

.section-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
}

/* 榜单 */
.leaderboard {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.rank-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #333333;
  border-radius: 22rpx;
  padding: 22rpx 20rpx;
  box-sizing: border-box;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.14);
}

.rank-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.rank-badge {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #444444;
  color: #d8d8d8;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.top-rank {
  background: #ffa116;
  color: #ffffff;
}

.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  margin-right: 18rpx;
  background: #555555;
  border: 3rpx solid rgba(255, 161, 22, 0.55);
  flex-shrink: 0;
}

.user-info {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.nickname {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lcid {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.58);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.total-count {
  font-size: 34rpx;
  font-weight: 800;
  color: #ffa116;
  margin-bottom: 8rpx;
  line-height: 1;
}

.daily-add {
  font-size: 22rpx;
  color: #bbbbbb;
}

/* 战队信息 */
.team-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #333333;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.team-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #ffa116;
  letter-spacing: 1rpx;
}

.team-count {
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.7);
}

/* 加载和空状态 */
.loading-area,
.empty-area {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 80rpx 0;
}

.loading-text,
.empty-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.45);
}