.login-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #e9f9ef 0%, #f5f5f5 45%);
}

.login-content {
  width: 100%;
  text-align: center;
}

.logo {
  display: block;
  font-size: 64rpx;
  font-weight: 700;
  color: #07c160;
}

.subtitle {
  display: block;
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #666666;
}

.wechat-btn {
  background-color: #07c160 !important;
  border: none;
  border-radius: 12rpx;
}

.dev-login-btn {
  background-color: #f0f0f0 !important;
  color: #999 !important;
  border: 1rpx dashed #ccc;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.hint-text {
  display: block;
  font-size: 26rpx;
  color: #888;
}

.openid-box {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

.openid-text {
  font-size: 26rpx;
  color: #333;
  word-break: break-all;
  font-family: monospace;
}
