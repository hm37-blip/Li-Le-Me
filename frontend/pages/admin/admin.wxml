<view class="container admin-page">

  <!-- 顶部栏 -->
  <view class="top-bar">
    <button class="btn-create" bindtap="openCreateModal">＋ 创建新战队</button>
    <button class="btn-logout" bindtap="handleLogout">退出</button>
  </view>

  <!-- 看板标题 -->
  <view class="board-header">
    <text class="board-title">战队看板</text>
    <text class="board-count">共 {{squads.length}} 支战队</text>
  </view>

  <!-- 状态提示 -->
  <view wx:if="{{fetchError}}" class="error-banner">{{fetchError}}</view>
  <view wx:elif="{{loadingSquads}}" class="hint">加载中...</view>
  <view wx:elif="{{squads.length === 0}}" class="hint">暂无战队，点击右上角创建第一支</view>

  <!-- 战队卡片列表 -->
  <view class="squad-card" wx:for="{{squads}}" wx:key="id">

    <!-- 卡片头：战队名 + 操作按钮 -->
    <view class="card-header">
      <text class="squad-name">{{item.squad_name}}</text>
      <view class="card-actions">
        <view class="btn-edit"
          data-id="{{item.id}}"
          data-name="{{item.squad_name}}"
          data-code="{{item.invite_code}}"
          data-max="{{item.max_members}}"
          bindtap="openEditModal">修改</view>
        <view class="btn-del"
          data-id="{{item.id}}"
          data-name="{{item.squad_name}}"
          bindtap="deleteSquad">删除</view>
      </view>
    </view>

    <!-- 基本信息区 -->
    <view class="info-block">
      <view class="info-row">
        <text class="info-label">邀请码</text>
        <text class="invite-code">{{item.invite_code}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">人数</text>
        <view class="member-count-bar">
          <text class="count-text">{{item.member_count}} / {{item.max_members}}</text>
        </view>
      </view>
    </view>

    <!-- 成员区 -->
    <view class="members-block">
      <text class="members-title">成员</text>

      <view wx:if="{{!item.membersLoaded}}" class="members-empty">加载中...</view>
      <view wx:elif="{{!item.members || item.members.length === 0}}" class="members-empty">暂无成员</view>
      <view wx:else>
        <view class="member-row"
          wx:for="{{item.showAll ? item.members : item.membersPreview}}"
          wx:key="id"
          wx:for-item="member">
          <view class="member-avatar">
            <text class="avatar-char">{{member.avatarChar}}</text>
          </view>
          <view class="member-info">
            <text class="member-nickname">{{member.nickname || '未设置昵称'}}</text>
            <text class="member-lc">LC：{{member.leetcode_username || '未绑定'}}</text>
          </view>
          <button class="btn-kick"
            data-squad-id="{{item.id}}"
            data-user-id="{{member.id}}"
            data-name="{{member.nickname}}"
            bindtap="removeMember">踢除</button>
        </view>

        <!-- 更多/收起 -->
        <button class="btn-more"
          wx:if="{{item.members.length > 3}}"
          data-id="{{item.id}}"
          bindtap="toggleShowAll">
          {{item.showAll ? '▲ 收起' : '▼ 查看全部 ' + item.members.length + ' 位成员'}}
        </button>
      </view>
    </view>

  </view>

  <!-- 底部留白 -->
  <view class="page-bottom" />

</view>

<!-- ══ 创建战队弹窗 ══ -->
<view class="modal-overlay" wx:if="{{showCreateModal}}" bindtap="closeCreateModal">
  <view class="modal-box" catchtap="noop">
    <view class="modal-title">创建新战队</view>

    <view class="modal-field">
      <text class="modal-label">名称<text class="required">【必填】</text></text>
      <input class="modal-input"
        placeholder="3–30个字符，汉字/数字/英文"
        value="{{form.name}}"
        bindinput="onFormNameInput"
        maxlength="30" />
      <text class="field-hint">支持汉字、数字、英文字母</text>
    </view>

    <view class="modal-field">
      <text class="modal-label">邀请码</text>
      <input class="modal-input"
        placeholder="自动生成，可自定义"
        value="{{form.code}}"
        bindinput="onFormCodeInput" />
      <text class="field-hint">留空则使用自动生成的邀请码</text>
    </view>

    <view class="modal-field">
      <text class="modal-label">人数上限</text>
      <input class="modal-input"
        type="number"
        placeholder="请输入 5–50 之间的整数"
        value="{{form.max}}"
        bindinput="onFormMaxInput" />
    </view>

    <text class="form-error" wx:if="{{formError}}">⚠ {{formError}}</text>

    <view class="modal-footer">
      <button class="btn-modal-cancel" bindtap="closeCreateModal">取消</button>
      <button class="btn-modal-confirm"
        loading="{{submittingForm}}"
        disabled="{{submittingForm}}"
        bindtap="handleCreateSquad">确定</button>
    </view>
  </view>
</view>

<!-- ══ 修改战队弹窗 ══ -->
<view class="modal-overlay" wx:if="{{showEditModal}}" bindtap="closeEditModal">
  <view class="modal-box" catchtap="noop">
    <view class="modal-title">修改战队信息</view>

    <view class="modal-field">
      <text class="modal-label">名称<text class="required">【必填】</text></text>
      <input class="modal-input"
        placeholder="3–30个字符，汉字/数字/英文"
        value="{{editForm.name}}"
        bindinput="onEditFormNameInput"
        maxlength="30" />
    </view>

    <view class="modal-field">
      <text class="modal-label">邀请码</text>
      <input class="modal-input"
        placeholder="可自定义"
        value="{{editForm.code}}"
        bindinput="onEditFormCodeInput" />
    </view>

    <view class="modal-field">
      <text class="modal-label">人数上限</text>
      <input class="modal-input"
        type="number"
        placeholder="5–50"
        value="{{editForm.max}}"
        bindinput="onEditFormMaxInput" />
    </view>

    <text class="form-error" wx:if="{{editFormError}}">⚠ {{editFormError}}</text>

    <view class="modal-footer">
      <button class="btn-modal-cancel" bindtap="closeEditModal">取消</button>
      <button class="btn-modal-confirm"
        loading="{{submittingEdit}}"
        disabled="{{submittingEdit}}"
        bindtap="handleEditSquad">确定</button>
    </view>
  </view>
</view>
