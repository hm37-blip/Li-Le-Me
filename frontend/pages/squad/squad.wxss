.invite-page {
  padding-top: 40rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #222222;
}

.subtitle {
  font-size: 26rpx;
  color: #666666;
}

.input {
  height: 88rpx;
  border: 2rpx solid #d9d9d9;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  background: #ffffff;
  transition: border-color 0.2s;
}

.input:focus {
  border-color: #07c160;
}

.input-error {
  border-color: #e53935 !important;
}

.error-text {
  display: block;
  margin-top: 12rpx;
  color: #d93025;
  font-size: 24rpx;
  font-weight: 500;
}

.submit-btn {
  background-color: #07c160 !important;
  border: none;
  border-radius: 12rpx;
}
