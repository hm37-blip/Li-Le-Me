
page {
  background: #282828;
  height: 100vh;
}

.page {
  height: 100vh;
  box-sizing: border-box;
  padding: 40rpx 32rpx calc(180rpx + env(safe-area-inset-bottom)) 32rpx;
  background: #282828;
}

.header {
  margin-bottom: 36rpx;
}

.header-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.header-subtitle {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.65);
}

.summary-card {
  background: linear-gradient(135deg, #ffa116 0%, #ffb84d 100%);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(255, 161, 22, 0.15);
}

.card-content {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.my-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f3f3f3;
  border: 3rpx solid rgba(255, 255, 255, 0.4);
  flex-shrink: 0;
}

.my-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.my-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.my-tier {
  font-size: 22rpx;
  font-weight: 600;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.25);
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.info-row-stats {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.stat-item {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
}

.share-btn {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 32rpx;
  padding: 14rpx 24rpx;
}

