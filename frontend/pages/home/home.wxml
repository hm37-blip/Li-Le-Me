<view class="container home-page">
  <view class="card">
    <view class="title">🎉 欢迎回来</view>
    <view class="desc mt-24">{{nickname || '同学'}}</view>
    <view class="desc mt-16">LeetCode 用户名：{{leetcodeUsername || '未绑定'}}</view>
    <view class="desc mt-16" wx:if="{{squadName}}">战队：{{squadName}}</view>
  </view>

  <view class="card mt-24">
    <view class="section-title">战队成员</view>
    <view wx:if="{{loadingMembers}}" class="hint">加载中...</view>
    <view wx:elif="{{members.length === 0}}" class="hint">暂无成员</view>
    <view wx:else>
      <view class="member-row" wx:for="{{members}}" wx:key="id">
        <text class="member-nickname">{{item.nickname || '未设置昵称'}}</text>
        <text class="member-lc">{{item.leetcode_username || '未绑定LC'}}</text>
      </view>
    </view>
  </view>

  <button class="report-btn mt-32" type="primary" bindtap="goReport">查看我的战报 📊</button>
  <button class="logout-btn mt-24" bindtap="handleLogout">退出登录</button>
</view>
