/* 全局页面基础设置 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  background-color: #f5f5f5;
  color: #1f1f1f;
  font-size: 14px;
  line-height: 1.6;
}

/* --- Cici 提供的布局规范 --- */
.container {
  padding: 32rpx;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 36rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}

/* --- Andy 提供的 LeetCode 官方配色规范 --- */
/* 主色调 - 橙色 (LeetCode 标志性颜色) + 灰色 */
.lc-primary { color: #FFA116; }
.lc-dark { color: #282828; }
.lc-bg-primary { background-color: #FFA116; }
.lc-bg-dark { background-color: #282828; }

/* 难度颜色规范 - 统一使用 LeetCode 官方逻辑 */
.difficulty-easy { color: #999999; }
.difficulty-medium { color: #FFA116; }
.difficulty-hard { color: #666666; }

/* --- 字体与间距工具类 (合并两人的命名习惯) --- */
.text-title { font-size: 16px; font-weight: 600; }
.text-body { font-size: 14px; }
.text-caption { font-size: 12px; }
.text-center { text-align: center; }

/* 统一间距 (使用 rpx 确保不同手机适配) */
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mb-10 { margin-bottom: 10rpx; }
.mb-20 { margin-bottom: 20rpx; }
