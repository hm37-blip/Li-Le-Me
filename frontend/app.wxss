/**
 * 全局样式表 - 橙灰色调 UI 设计系统
 * 参考 LeetCode 配色方案
 */

/* ========================================
   1. 基础页面样式
   ======================================== */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
  background-color: #f5f5f5;
  color: #262626;
  font-size: 28rpx;
  line-height: 1.6;
}

/* ========================================
   2. 颜色变量定义（通过类名模拟 CSS 变量）
   ======================================== */

/* 主色调 - 橙色系 */
.color-primary {
  color: #FFA116;
}

.bg-primary {
  background-color: #FFA116;
}

.color-primary-light {
  color: #FFB84D;
}

.bg-primary-light {
  background-color: #FFB84D;
}

.color-primary-dark {
  color: #E68900;
}

.bg-primary-dark {
  background-color: #E68900;
}

/* 文字颜色 - 灰色系 */
.color-text-primary {
  color: #262626;
}

.color-text-secondary {
  color: #595959;
}

.color-text-tertiary {
  color: #8c8c8c;
}

.color-text-disabled {
  color: #bfbfbf;
}

/* 背景颜色 */
.bg-white {
  background-color: #ffffff;
}

.bg-gray-50 {
  background-color: #fafafa;
}

.bg-gray-100 {
  background-color: #f5f5f5;
}

.bg-gray-200 {
  background-color: #eeeeee;
}

.bg-gray-800 {
  background-color: #262626;
}

.bg-gray-900 {
  background-color: #141414;
}

/* 功能色 */
.color-success {
  color: #52c41a;
}

.bg-success {
  background-color: #52c41a;
}

.color-warning {
  color: #faad14;
}

.bg-warning {
  background-color: #faad14;
}

.color-error {
  color: #ff4d4f;
}

.bg-error {
  background-color: #ff4d4f;
}

.color-info {
  color: #1890ff;
}

.bg-info {
  background-color: #1890ff;
}

/* 难度标签颜色 */
.color-easy {
  color: #52c41a;
}

.bg-easy {
  background-color: #f6ffed;
}

.color-medium {
  color: #FFA116;
}

.bg-medium {
  background-color: #fff7e6;
}

.color-hard {
  color: #ff4d4f;
}

.bg-hard {
  background-color: #fff1f0;
}

/* ========================================
   3. 间距工具类
   ======================================== */

/* Margin */
.m-0 { margin: 0; }
.m-8 { margin: 8rpx; }
.m-16 { margin: 16rpx; }
.m-24 { margin: 24rpx; }
.m-32 { margin: 32rpx; }
.m-48 { margin: 48rpx; }

.mt-0 { margin-top: 0; }
.mt-8 { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mt-48 { margin-top: 48rpx; }

.mb-0 { margin-bottom: 0; }
.mb-8 { margin-bottom: 8rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
.mb-32 { margin-bottom: 32rpx; }
.mb-48 { margin-bottom: 48rpx; }

.ml-8 { margin-left: 8rpx; }
.ml-16 { margin-left: 16rpx; }
.ml-24 { margin-left: 24rpx; }

.mr-8 { margin-right: 8rpx; }
.mr-16 { margin-right: 16rpx; }
.mr-24 { margin-right: 24rpx; }

/* Padding */
.p-0 { padding: 0; }
.p-8 { padding: 8rpx; }
.p-16 { padding: 16rpx; }
.p-24 { padding: 24rpx; }
.p-32 { padding: 32rpx; }
.p-48 { padding: 48rpx; }

.pt-16 { padding-top: 16rpx; }
.pt-24 { padding-top: 24rpx; }
.pt-32 { padding-top: 32rpx; }

.pb-16 { padding-bottom: 16rpx; }
.pb-24 { padding-bottom: 24rpx; }
.pb-32 { padding-bottom: 32rpx; }

.px-16 { padding-left: 16rpx; padding-right: 16rpx; }
.px-24 { padding-left: 24rpx; padding-right: 24rpx; }
.px-32 { padding-left: 32rpx; padding-right: 32rpx; }

.py-16 { padding-top: 16rpx; padding-bottom: 16rpx; }
.py-24 { padding-top: 24rpx; padding-bottom: 24rpx; }
.py-32 { padding-top: 32rpx; padding-bottom: 32rpx; }

/* ========================================
   4. 字体工具类
   ======================================== */

.text-xs { font-size: 20rpx; }
.text-sm { font-size: 24rpx; }
.text-base { font-size: 28rpx; }
.text-lg { font-size: 32rpx; }
.text-xl { font-size: 36rpx; }
.text-2xl { font-size: 40rpx; }
.text-3xl { font-size: 48rpx; }

.font-normal { font-weight: 400; }
.font-medium { font-weight: 500; }
.font-semibold { font-weight: 600; }
.font-bold { font-weight: 700; }

.text-left { text-align: left; }
.text-center { text-align: center; }
.text-right { text-align: right; }

/* ========================================
   5. 布局工具类
   ======================================== */

.container {
  padding: 32rpx;
}

.container-sm {
  padding: 24rpx;
}

.container-lg {
  padding: 48rpx;
}

/* Flexbox */
.flex {
  display: flex;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-row {
  display: flex;
  flex-direction: row;
}

.flex-wrap {
  flex-wrap: wrap;
}

.items-center {
  align-items: center;
}

.items-start {
  align-items: flex-start;
}

.items-end {
  align-items: flex-end;
}

.justify-center {
  justify-content: center;
}

.justify-between {
  justify-content: space-between;
}

.justify-around {
  justify-content: space-around;
}

.justify-start {
  justify-content: flex-start;
}

.justify-end {
  justify-content: flex-end;
}

.flex-1 {
  flex: 1;
}

/* ========================================
   6. 通用卡片样式
   ======================================== */

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 24rpx;
}

.card-sm {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-lg {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 40rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.06);
}

.card-borderless {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  border: 1rpx solid #f0f0f0;
}

/* ========================================
   7. 通用按钮样式
   ======================================== */

/* 基础按钮 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 40rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.3s ease;
  border: none;
  cursor: pointer;
}

/* 主要按钮 - 橙色 */
.btn-primary {
  background-color: #FFA116;
  color: #ffffff;
}

.btn-primary:active {
  background-color: #E68900;
  opacity: 0.9;
}

/* 次要按钮 - 灰色边框 */
.btn-secondary {
  background-color: transparent;
  color: #262626;
  border: 2rpx solid #d9d9d9;
}

.btn-secondary:active {
  border-color: #FFA116;
  color: #FFA116;
}

/* 文本按钮 */
.btn-text {
  background-color: transparent;
  color: #FFA116;
  padding: 12rpx 24rpx;
}

.btn-text:active {
  color: #E68900;
}

/* 危险按钮 */
.btn-danger {
  background-color: #ff4d4f;
  color: #ffffff;
}

.btn-danger:active {
  background-color: #d9363e;
}

/* 成功按钮 */
.btn-success {
  background-color: #52c41a;
  color: #ffffff;
}

.btn-success:active {
  background-color: #389e0d;
}

/* 按钮尺寸 */
.btn-sm {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
}

.btn-lg {
  padding: 28rpx 56rpx;
  font-size: 32rpx;
  border-radius: 16rpx;
}

.btn-block {
  width: 100%;
  display: flex;
}

/* 禁用状态 */
.btn-disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* ========================================
   8. 通用输入框样式
   ======================================== */

.input {
  width: 100%;
  padding: 24rpx 28rpx;
  border: 2rpx solid #d9d9d9;
  border-radius: 12rpx;
  font-size: 28rpx;
  background-color: #ffffff;
  color: #262626;
  transition: all 0.3s ease;
}

.input:focus {
  border-color: #FFA116;
  outline: none;
}

.input-error {
  border-color: #ff4d4f;
}

.input-disabled {
  background-color: #f5f5f5;
  color: #bfbfbf;
  cursor: not-allowed;
}

/* 输入框组 */
.input-group {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.input-label {
  font-size: 28rpx;
  color: #595959;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.input-hint {
  font-size: 24rpx;
  color: #8c8c8c;
  margin-top: 8rpx;
}

.input-error-text {
  font-size: 24rpx;
  color: #ff4d4f;
  margin-top: 8rpx;
}

/* ========================================
   9. 标签 (Tag) 样式
   ======================================== */

.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.tag-primary {
  background-color: #fff7e6;
  color: #FFA116;
}

.tag-success {
  background-color: #f6ffed;
  color: #52c41a;
}

.tag-error {
  background-color: #fff1f0;
  color: #ff4d4f;
}

.tag-info {
  background-color: #e6f7ff;
  color: #1890ff;
}

.tag-gray {
  background-color: #fafafa;
  color: #595959;
}

/* ========================================
   10. 徽章 (Badge) 样式
   ======================================== */

.badge {
  display: inline-block;
  padding: 0 12rpx;
  height: 36rpx;
  line-height: 36rpx;
  border-radius: 18rpx;
  font-size: 20rpx;
  font-weight: 500;
  text-align: center;
  white-space: nowrap;
}

.badge-primary {
  background-color: #FFA116;
  color: #ffffff;
}

.badge-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  padding: 0;
}

/* ========================================
   11. 分割线样式
   ======================================== */

.divider {
  height: 1rpx;
  background-color: #f0f0f0;
  margin: 32rpx 0;
}

.divider-vertical {
  width: 1rpx;
  height: 32rpx;
  background-color: #f0f0f0;
  margin: 0 16rpx;
  display: inline-block;
}

/* ========================================
   12. 列表样式
   ======================================== */

.list-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.list-item:last-child {
  border-bottom: none;
}

.list-item-active {
  background-color: #fff7e6;
}

/* ========================================
   13. 头像样式
   ======================================== */

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  background-color: #f5f5f5;
}

.avatar-sm {
  width: 56rpx;
  height: 56rpx;
}

.avatar-lg {
  width: 120rpx;
  height: 120rpx;
}

.avatar-xl {
  width: 160rpx;
  height: 160rpx;
}

/* ========================================
   14. 空状态样式
   ======================================== */

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 32rpx;
}

.empty-icon {
  font-size: 96rpx;
  color: #d9d9d9;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #8c8c8c;
}

/* ========================================
   15. 加载状态样式
   ======================================== */

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #8c8c8c;
  margin-left: 16rpx;
}

/* ========================================
   16. 其他通用样式
   ======================================== */

/* 圆角 */
.rounded-sm { border-radius: 8rpx; }
.rounded { border-radius: 12rpx; }
.rounded-lg { border-radius: 16rpx; }
.rounded-xl { border-radius: 20rpx; }
.rounded-full { border-radius: 9999rpx; }

/* 阴影 */
.shadow-sm {
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.shadow {
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.shadow-lg {
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

/* 边框 */
.border {
  border: 1rpx solid #f0f0f0;
}

.border-primary {
  border: 1rpx solid #FFA116;
}

.border-gray {
  border: 1rpx solid #d9d9d9;
}

/* 溢出处理 */
.truncate {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.line-clamp-3 {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
